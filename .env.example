# ============================================================
# OrcaMet Portal — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Django
SECRET_KEY=change-me-to-a-real-secret-key
# Defaults to on locally and off on Render; only set it to override that.
DJANGO_DEBUG=True

# HSTS lifetime in seconds (production only). Leave at 3600 until HTTPS is
# confirmed on every hostname served, then raise to 31536000.
# DJANGO_HSTS_SECONDS=3600

# Database (local development — PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orcamet_portal

# Auth0
AUTH0_DOMAIN=your-tenant.uk.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# CARTO basemap key — without it the map tiles carry an
# "API KEY REQUIRED" watermark. Restrict it by domain in the CARTO
# dashboard; it is served to the browser, not held secret.
CARTO_API_KEY=your-carto-basemap-key

# Open-Meteo API key
OPENMETEO_API_KEY=your-api-key

# Render (set automatically by Render in production)
# RENDER_EXTERNAL_HOSTNAME=orcamet-portal.onrender.com
# RENDER_API_KEY=rnd_abc123...
